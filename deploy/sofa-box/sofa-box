#!/bin/sh
# The Sofa box: a Raspberry Pi (or any small Linux computer) on the TV that opens Sofa full screen.
#   sofa-box doctor            check everything, and say what to do about anything wrong
#   sofa-box status            what's running
#   sofa-box logs              what it's been saying
#   sofa-box report            the checks and logs that Settings → Help → Send a report sends (sudo)
#   sofa-box choose            pick (again) which Sofa it uses
#   sofa-box pair-controller   pair a Bluetooth game controller (Xbox, PlayStation, 8BitDo…)
#   sofa-box tv-on             wake the TV and switch it to the box (HDMI-CEC)
#   sofa-box desktop           go back to the desktop instead of Sofa (sudo; undo: sofa-box appliance)
#   sofa-box shield on|off|update   Sofa Shield: ads and trackers kept out of the whole box (sudo)
#   sofa-box update            the newest Sofa Box from GitHub (sudo)
#   sofa-box tune              a quick processor for the TV (sudo; at every start)
#   sofa-box factory-reset     back to how it came: apps, sign-ins, Wi-Fi, Bluetooth, files gone (sudo)
#   sofa-box kiosk             the TV's screen (started by sofa-box.service; not by hand)
set -e
LIB=/usr/local/lib/sofa-box
AGENT=http://127.0.0.1:8091
SERVICES="sofa-box-agent sofa-box sofa-box-input sofa-box-cec"

boot_dir() { for d in /boot/firmware /boot; do [ -f "$d/config.txt" ] && { echo "$d"; return; }; done; }

# Wi-Fi on (root). Raspberry Pi OS starts with Wi-Fi switched off until a country is set in Raspberry Pi Imager
# (NetworkManager's WirelessEnabled=false, or an rfkill block); a box set up with no network then can't make its own
# Wi-Fi for the phone, and its setup waits for ever. "--files": only what's saved (building a card).
wifi_on() {
  S=/var/lib/NetworkManager/NetworkManager.state
  if [ -f "$S" ] && grep -q '^WirelessEnabled=false' "$S"; then sed -i 's/^WirelessEnabled=false/WirelessEnabled=true/' "$S"; fi
  for f in /var/lib/systemd/rfkill/*:wlan /var/lib/systemd/rfkill/*:bluetooth; do      # (Bluetooth too: the remotes)
    if [ -f "$f" ]; then echo 0 > "$f" 2>/dev/null || true; fi
  done
  [ "${1:-}" = --files ] && return 0
  if command -v rfkill >/dev/null; then rfkill unblock wifi 2>/dev/null || true; rfkill unblock bluetooth 2>/dev/null || true; fi
  if command -v nmcli >/dev/null; then nmcli radio wifi on 2>/dev/null || true; fi
  if command -v bluetoothctl >/dev/null; then timeout 10 bluetoothctl power on >/dev/null 2>&1 || true; fi
}

# Update and Reset, started from the TV, run inside the agent's service; they restart or stop that service,
# which would end them half way. So they start again as their own short service, out of its reach.
on_its_own() {
  [ -z "$SOFA_BOX_ON_ITS_OWN" ] && grep -q 'sofa-box-agent' /proc/self/cgroup 2>/dev/null && command -v systemd-run >/dev/null || return 0
  exec systemd-run --quiet --collect --unit="sofa-box-$1" --setenv=SOFA_BOX_ON_ITS_OWN=1 \
    --setenv=SUDO_USER="${SUDO_USER:-}" --setenv=SOFA_BOX_BRANCH="${SOFA_BOX_BRANCH:-main}" "$0" "$1"
}

# How big Sofa's pages are drawn: twice on a 1080p TV (like Fire TV), so they read from the sofa.
scale() {
  [ -n "$SOFA_BOX_SCALE" ] && { echo "$SOFA_BOX_SCALE"; return; }
  for c in /sys/class/drm/card*-HDMI-A-*; do
    [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
    H="$(head -n 1 "$c/modes" 2>/dev/null | cut -dx -f2 | tr -dc 0-9)"
    [ -n "$H" ] || continue
    if [ "$H" -ge 2160 ]; then echo 4; elif [ "$H" -ge 1080 ]; then echo 2; elif [ "$H" -ge 720 ]; then echo 1.33; else echo 1; fi
    return
  done
  echo 2
}

kiosk() {
  if [ "${SOFA_BOX_SCREEN:-wayland}" = wayland ] && command -v cage >/dev/null; then
    exec cage -d -- "$0" session
  fi
  exec xinit "$0" session -- :0 vt1 -nocursor -s 0 -dpms -nolisten tcp
}

session() {
  BROWSER="$(command -v chromium || command -v chromium-browser || true)"
  [ -n "$BROWSER" ] || { echo "Chromium isn't installed (sudo apt install chromium)."; exit 1; }
  # Where this screen is, for the agent's player (mpv opens on top of the browser).
  RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  # How big pages are drawn (twice on a 1080p TV, so they read from the sofa). On Wayland, Chromium's own
  # --force-device-scale-factor makes it a window a quarter of the screen (in the top-left corner): there the
  # window gets the whole screen as it is, and the agent sizes each page instead (SCALE, through DevTools).
  SCALE="$(scale)"
  if [ -n "$WAYLAND_DISPLAY" ]; then
    printf 'WAYLAND_DISPLAY=%s\nDISPLAY=%s\nSCALE=%s\n' "$WAYLAND_DISPLAY" "${DISPLAY:-}" "$SCALE" > "$RUN/sofa-box-display"   # (DISPLAY: cage's XWayland, for games made for X)
    PLATFORM="--ozone-platform=wayland"
  else
    printf 'DISPLAY=%s\nXAUTHORITY=%s\nSCALE=1\n' "$DISPLAY" "${XAUTHORITY:-$HOME/.Xauthority}" > "$RUN/sofa-box-display"
    xset s off -dpms s noblank 2>/dev/null || true
    PLATFORM="--ozone-platform=x11 --force-device-scale-factor=$SCALE"
  fi
  PROFILE="$HOME/.config/sofa-box/browser"
  mkdir -p "$PROFILE"
  LOW=""
  # A small board (1 GB or less, or a Pi 3 and older): lighter Chromium, its cache in memory (the card is slow).
  # (Scrolling stays smooth: the compositor does it, and jumps feel broken on a TV.) Every board: nothing fetched in
  # the background that nobody asked for, and the remote's arrows move between a site's links and buttons
  # (spatial navigation; pages that handle the arrows themselves, like Home and Sofa, keep doing so).
  MEM_MB=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
  PERF="$(grep -o '"performance": *"[a-z]*"' "$HOME/.config/sofa-box/settings.json" 2>/dev/null | sed 's/.*"\([a-z]*\)"$/\1/')"
  if [ "$PERF" = light ] || { [ "$PERF" != full ] && { grep -Eqs 'Raspberry Pi (Zero|[1-3])\b' /proc/device-tree/model || [ "${MEM_MB:-4096}" -le 1100 ]; }; }; then
    mkdir -p "$RUN/sofa-box-cache"
    LOW="--enable-low-end-device-mode --renderer-process-limit=2 --disk-cache-dir=$RUN/sofa-box-cache --disk-cache-size=33554432"
  fi
  LOW="$LOW --disable-background-networking --disable-component-update"
  # The home screen comes from the agent: wait for it (a Pi 3 starting up takes a moment), so the TV never
  # shows the browser's "can't reach this page".
  for _ in $(seq 1 60); do curl -fs -o /dev/null -m 2 "$AGENT/box/state" && break; sleep 0.5; done
  while true; do
    # A browser that crashed or lost power mid-way shows "Restore pages?": tell it all went well.
    sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' \
      "$PROFILE/Default/Preferences" 2>/dev/null || true
    "$BROWSER" --kiosk --noerrdialogs --disable-infobars --no-first-run --disable-session-crashed-bubble \
      --disable-features=Translate,MediaRouter,HardwareMediaKeyHandling --password-store=basic --enable-spatial-navigation \
      --autoplay-policy=no-user-gesture-required --check-for-update-interval=31536000 --overscroll-history-navigation=0 \
      --disable-pinch --disk-cache-size=67108864 $LOW $PLATFORM \
      --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 \
      --user-data-dir="$PROFILE" "http://127.0.0.1:8091/box/home" || true
    sleep 1
  done
}

# (root, before the screen starts) The boot screen stays, moving, until the box's helper answers (a Pi 3's first start
# takes a while), then goes: Home follows at once, instead of a still or black screen while the browser waits for it.
before_screen() {
  END=$(( $(date +%s) + 60 ))                  # a minute at most (systemd gives a start 90 seconds)
  until curl -fs -o /dev/null -m 2 "$AGENT/box/state" || [ "$(date +%s)" -ge "$END" ]; do sleep 0.5; done
  if command -v plymouth >/dev/null; then plymouth quit --retain-splash 2>/dev/null || true; fi
}

pair_controller() {
  command -v bluetoothctl >/dev/null || { echo "Bluetooth tools are missing (sudo apt install bluez)."; exit 1; }
  echo "Put the controller in pairing mode now:"
  echo "  Xbox: hold the small pairing button on top until the Xbox button flashes fast."
  echo "  PlayStation: hold Share (or Create) and the PS button until the light flashes."
  echo "  8BitDo: hold Start (Android/X mode) or the pair button until the lights flash."
  bluetoothctl power on >/dev/null
  bluetoothctl --timeout 25 scan on >/dev/null 2>&1 &
  SCAN=$!
  MAC=""
  for _ in $(seq 1 25); do
    sleep 1
    MAC="$(bluetoothctl devices | grep -iE 'xbox|wireless controller|dualsense|dualshock|8bitdo|pro controller|gamepad|controller' \
           | head -n 1 | awk '{print $2}')"
    [ -n "$MAC" ] && break
  done
  kill "$SCAN" 2>/dev/null || true
  [ -n "$MAC" ] || { echo "No controller found. Try again, with it flashing fast."; exit 1; }
  NAME="$(bluetoothctl devices | grep "$MAC" | cut -d' ' -f3-)"
  echo "Found $NAME ($MAC). Pairing…"
  bluetoothctl --agent NoInputNoOutput pair "$MAC" || bluetoothctl pair "$MAC"
  bluetoothctl trust "$MAC"
  bluetoothctl connect "$MAC"
  echo "Done: $NAME is paired. It connects by itself from now on (press its Home button)."
}

apply_boot() {               # (root) the boot screen in the box's theme and name
  SETTINGS="${1:-}"
  [ -n "$SETTINGS" ] || SETTINGS="$(getent passwd "${SUDO_USER:-1000}" | cut -d: -f6)/.config/sofa-box/settings.json"
  command -v plymouth-set-default-theme >/dev/null || { echo "Plymouth isn't installed (sudo apt install plymouth)."; exit 1; }
  python3 "$LIB/sofa-box-art.py" plymouth /usr/share/plymouth/themes/sofa "$SETTINGS"
  plymouth-set-default-theme sofa
  if [ "${2:-}" != --no-initramfs ] && command -v update-initramfs >/dev/null; then
    update-initramfs -u >/dev/null 2>&1 || true
  fi
  echo "The boot screen is set: it shows from the next start."
}

setup_boot() {               # (root) a Raspberry Pi's config.txt and cmdline.txt, for the box
  B="${1:-$(boot_dir)}"; [ -f "$B/config.txt" ] || { echo "No config.txt in $B: not a Raspberry Pi?"; exit 1; }
  CFG="$B/config.txt" CMD="$B/cmdline.txt"
  [ -f "$CFG.before-sofa-box" ] || cp "$CFG" "$CFG.before-sofa-box"
  [ -f "$CMD.before-sofa-box" ] || cp "$CMD" "$CMD.before-sofa-box"
  if grep -Eq '^[[:space:]]*hdmi_cvt[[:space:]=]+480 320|^[[:space:]]*dtoverlay=(mhs35|tft35a|waveshare35)' "$CFG" || command -v fbcp >/dev/null 2>&1; then
    echo "   A 3.5-inch screen set up with LCD-show: the TV gets its full picture back, and the small screen is switched off."
    # LCD-show squeezes the TV's picture to 480x320 to copy it onto the small screen (fbcp): undo that.
    sed -i -E 's/^([[:space:]]*(hdmi_cvt|hdmi_group|hdmi_mode)[[:space:]=])/#sofa-box# \1/' "$CFG"
    sed -i -E 's/^([[:space:]]*dtoverlay=vc4-fkms-v3d)/#sofa-box# \1/' "$CFG"
    # The small screen's driver too: with nothing on the pins, its touch part can send stray clicks to the TV.
    sed -i -E 's/^([[:space:]]*dtoverlay=(mhs35|mhs32|mhs24|tft35a|lcd35|waveshare35[a-z]*))/#sofa-box# \1/' "$CFG"
    sed -i -E 's/^[[:space:]]*#+[[:space:]]*(dtoverlay=vc4-kms-v3d)/\1/' "$CFG"
    R="${SOFA_BOX_ROOT:-}"      # (tests point this at a folder of their own)
    [ -f "$R/etc/rc.local" ] && sed -i -E '/^[[:space:]]*(\/usr\/local\/bin\/)?fbcp/ s/^/#sofa-box# /' "$R/etc/rc.local"
    [ -z "$R" ] && { pkill -x fbcp 2>/dev/null || true; }
    for x in "$R/etc/X11/xorg.conf.d/99-fbturbo.conf" "$R/usr/share/X11/xorg.conf.d/99-fbturbo.conf"; do
      [ -f "$x" ] && mv "$x" "$x.off-for-sofa-box"
    done
    sed -i -E 's/ ?fbcon=map:[0-9]+//; s/ ?fbcon=font:[^ ]+//' "$CMD"
  fi
  grep -Eq '^[[:space:]]*dtoverlay=vc4-kms-v3d' "$CFG" || printf '\n[all]\ndtoverlay=vc4-kms-v3d\n' >> "$CFG"
  grep -Eq '^[[:space:]]*disable_splash=' "$CFG" || echo "disable_splash=1" >> "$CFG"          # no rainbow square
  # Sound goes to the TV: the Pi's headphone socket would otherwise come first.
  sed -i -E 's/^[[:space:]]*dtparam=audio=on/dtparam=audio=off/' "$CFG"
  # A quiet start: the boot screen instead of scrolling text.
  for w in quiet splash plymouth.ignore-serial-consoles logo.nologo vt.global_cursor_default=0 loglevel=3; do
    grep -qw -- "$w" "$CMD" || sed -i "1 s/\$/ $w/" "$CMD"
  done
  sed -i 's/console=tty1/console=tty3/' "$CMD"
}

# Sofa Shield: a blocklist of ad and tracker sites in /etc/hosts, between two marker lines.
SHIELD_LIST="${SOFA_BOX_SHIELD_LIST:-https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts}"
shield() {                    # (root)
  HOSTS="${SOFA_BOX_HOSTS:-/etc/hosts}"
  KEEP="$(mktemp)"
  sed '/^# >>> Sofa Shield/,/^# <<< Sofa Shield/d' "$HOSTS" > "$KEEP"
  case "${1:-}" in
    on|update)
      LIST="$(mktemp)"
      if ! curl -fsSL --max-time 90 "$SHIELD_LIST" -o "$LIST"; then
        rm -f "$LIST" "$KEEP"; echo "Couldn't fetch the blocklist (is the box online?)."; exit 1
      fi
      grep -E '^0\.0\.0\.0[[:space:]]+[A-Za-z0-9]' "$LIST" | awk '{print $2}' \
        | grep -vE '^(0\.0\.0\.0|localhost|localhost\.localdomain|local|broadcasthost)$' | sort -u > "$LIST.names"
      N="$(wc -l < "$LIST.names" | tr -d ' ')"
      if [ "$N" -lt 1000 ]; then rm -f "$LIST" "$LIST.names" "$KEEP"; echo "The blocklist looks wrong ($N sites): left as it was."; exit 1; fi
      { cat "$KEEP"; echo "# >>> Sofa Shield ($N sites, $(date -u +%Y-%m-%d)): sofa-box shield off takes it out"
        sed 's/^/0.0.0.0 /' "$LIST.names"; echo "# <<< Sofa Shield"; } > "$LIST.hosts"
      cat "$LIST.hosts" > "$HOSTS"                 # the same file (its owner and links stay)
      rm -f "$LIST" "$LIST.names" "$LIST.hosts" "$KEEP"
      echo "Sofa Shield is on: $N ad and tracker sites kept out." ;;
    off)
      cat "$KEEP" > "$HOSTS"; rm -f "$KEEP"
      echo "Sofa Shield is off." ;;
    *) rm -f "$KEEP"; echo "sofa-box shield on|off|update"; exit 1 ;;
  esac
}

ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad() { printf '  \033[31m✗\033[0m %s\n' "$1"; [ -n "$2" ] && printf '      → %s\n' "$2"; PROBLEMS=$((PROBLEMS + 1)); }
note() { printf '  · %s\n' "$*"; }

doctor() {
  set +e                     # look at everything, whatever fails
  PROBLEMS=0
  echo "The Sofa box"
  note "$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || uname -m), $(. /etc/os-release; echo "$PRETTY_NAME")"
  note "memory $(awk '/MemTotal/ {printf "%d MB", $2/1024}' /proc/meminfo), $(awk '/MemAvailable/ {printf "%d MB free", $2/1024}' /proc/meminfo)"
  if command -v vcgencmd >/dev/null; then
    T="$(vcgencmd get_throttled 2>/dev/null | cut -d= -f2)"
    case "$T" in
      0x0) ok "power supply: steady" ;;
      "") ;;
      *) bad "power: the Pi has been short of power or too hot ($T)" "use the official 2.5 A (Pi 3) power supply and a short cable" ;;
    esac
    note "temperature $(vcgencmd measure_temp 2>/dev/null | cut -d= -f2)"
  fi
  echo "Running"
  for s in $SERVICES; do
    if systemctl is-active --quiet "$s"; then ok "$s"; else bad "$s isn't running" "sofa-box logs   (then: sudo systemctl restart $s)"; fi
  done
  echo "Sofa"
  STATE="$(curl -fsS -m 3 $AGENT/box/state 2>/dev/null || true)"
  if [ -z "$STATE" ]; then bad "the box's agent doesn't answer on $AGENT" "sudo systemctl restart sofa-box-agent"
  else
    URL="$(echo "$STATE" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("chosen") or "")')"
    if [ -n "$URL" ] && curl -fsS -m 3 "$URL/api/info" >/dev/null 2>&1; then ok "uses Sofa at $URL"
    elif [ -n "$URL" ]; then bad "Sofa at $URL doesn't answer" "is the Sofa computer on and awake? Or: sofa-box choose"
    else bad "hasn't found Sofa yet" "is the Sofa computer on, on the same network? Or type its address on the TV"
    fi
  fi
  if curl -fsS -m 3 http://127.0.0.1:9222/json/version >/dev/null 2>&1; then ok "the home screen's browser answers the agent (DevTools)"
  else bad "the browser's DevTools port doesn't answer" "sudo systemctl restart sofa-box"; fi
  if grep -q '^# >>> Sofa Shield' /etc/hosts; then ok "Sofa Shield: $(grep -c '^0\.0\.0\.0 ' /etc/hosts) sites kept out"
  else note "Sofa Shield is off (Settings → Sofa Shield)"; fi
  echo "Picture and sound"
  for b in mpv cage; do command -v $b >/dev/null && ok "$b" || { [ $b = cage ] && note "no cage: the screen uses X" || bad "$b is missing" "sudo apt install $b"; }; done
  command -v chromium >/dev/null || command -v chromium-browser >/dev/null && ok "chromium" || bad "chromium is missing" "sudo apt install chromium"
  for c in /sys/class/drm/card*-HDMI-A-*; do
    [ -e "$c/status" ] || continue
    if [ "$(cat "$c/status")" = connected ]; then ok "TV on ${c##*-HDMI-}: $(head -n 1 "$c/modes"), pages drawn at ×$(scale)"
    else note "${c##*/}: nothing connected"; fi
  done
  if grep -Eqs 'Raspberry Pi' /proc/device-tree/model; then
    if mpv --hwdec=help 2>/dev/null | grep -q v4l2m2m && [ -e /dev/video10 ]; then ok "the Pi's video decoder (H.264) for mpv"
    else bad "mpv can't use the Pi's video decoder" "Raspberry Pi OS Bookworm has it; make sure dtoverlay=vc4-kms-v3d is in config.txt"; fi
    B="$(boot_dir)"
    grep -Eq '^[[:space:]]*hdmi_cvt[[:space:]=]+480 320' "$B/config.txt" && bad "the TV is set to 480×320 (LCD-show)" "run the installer again: it fixes that"
  fi
  aplay -l 2>/dev/null | grep -qi hdmi && ok "sound to the TV over HDMI" || note "no HDMI sound device seen (is the TV on?)"
  echo "Remotes"
  if ls /dev/cec* >/dev/null 2>&1; then
    P="$(cec-ctl -d /dev/cec0 2>/dev/null | sed -n 's/.*Physical Address *: *\([0-9a-f.]*\).*/\1/p' | head -n 1)"
    [ -n "$P" ] && [ "$P" != f.f.f.f ] && ok "HDMI-CEC: the TV is there ($P)" || note "HDMI-CEC: the TV doesn't answer (turn on VIERA Link / Anynet+ / SimpLink)"
  else note "no HDMI-CEC on this computer"; fi
  if [ -e /dev/uinput ]; then ok "virtual keys (uinput)"; else bad "no /dev/uinput" "sudo modprobe uinput"; fi
  P="$(bluetoothctl devices Paired 2>/dev/null | cut -d' ' -f3- | paste -sd, - || true)"
  [ -n "$P" ] && ok "paired: $P" || note "no Bluetooth controllers paired (sofa-box pair-controller)"
  echo
  [ "$PROBLEMS" = 0 ] && echo "All good." || echo "$PROBLEMS thing(s) to look at (above)."
}

# (root) What Send a report sends, with the box's agent cutting addresses down and leaving titles out: the checks,
# the network and Bluetooth, then the logs since the box started (they're kept in memory: a restart clears them).
report() {
  set +e
  echo "== Sofa Box OS $(cat $LIB/VERSION 2>/dev/null), $(date -u '+%Y-%m-%d %H:%M UTC'), $(uptime -p 2>/dev/null)"
  doctor 2>&1 | sed 's/\x1b\[[0-9;]*m//g'
  echo; echo "== Network"
  nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device 2>&1
  rfkill list 2>&1
  echo; echo "== Bluetooth"
  bluetoothctl show 2>&1 | grep -E 'Controller|Powered|Discoverable|Pairable|Discovering'
  bluetoothctl devices 2>&1 | head -n 20
  echo; echo "== Starts"
  journalctl --list-boots --no-pager 2>&1 | tail -n 5
  # shellcheck disable=SC2046
  { echo; echo "== The box, since it started"
    journalctl -b --no-pager -o short-monotonic -n 600 $(for s in $SERVICES; do printf ' -u %s' "$s"; done)
    echo; echo "== Wi-Fi and Bluetooth"
    journalctl -b --no-pager -o short-monotonic -n 150 -u NetworkManager -u bluetooth
    echo; echo "== Warnings and errors, the whole box"
    journalctl -b --no-pager -o short-monotonic -n 200 -p warning
    for f in /home/*/.local/share/sofa-box/games/last-game.log; do
      [ -f "$f" ] && { echo; echo "== The games it opened last (each start marked ==)"; tail -n 120 "$f"; }
    done
    if journalctl -b -1 -n 1 --no-pager >/dev/null 2>&1; then
      echo; echo "== How the start before this one ended"
      journalctl -b -1 --no-pager -o short-monotonic -n 40
      echo; echo "== Its warnings and errors"
      journalctl -b -1 --no-pager -o short-monotonic -p warning -n 40
    fi
    command -v vcgencmd >/dev/null && { echo; echo "== Power (0x0: always enough since it started)"; vcgencmd get_throttled; }; } 2>&1 | cut -c 1-400
}

games() {                    # (root) a game from the box's list (games/games.json): its packages only, nothing else
  ACTION="${1:-}"; ID="${2:-}"
  PKGS="$(python3 - "$LIB/games/games.json" "$ID" <<'EOF'
import json, re, sys
g = next((g for g in json.load(open(sys.argv[1], encoding="utf-8")).get("native", []) if g["id"] == sys.argv[2]), None)
print(" ".join(p for p in (g or {}).get("packages", []) if re.match(r"^[a-z0-9][a-z0-9.+-]*$", p)))
EOF
)"
  [ -n "$PKGS" ] || { echo "E: No game called '$ID' in the box's list."; exit 2; }
  export DEBIAN_FRONTEND=noninteractive
  case "$ACTION" in
    install)
      apt-get -o DPkg::Lock::Timeout=180 update -qq || true
      # (the downloaded packages aren't kept once they're in: Sauerbraten's alone is nearly 1 GB)
      # shellcheck disable=SC2086
      apt-get -o DPkg::Lock::Timeout=180 -o APT::Keep-Downloaded-Packages=false install -y --no-install-recommends $PKGS ;;
    remove)
      # shellcheck disable=SC2086
      apt-get -o DPkg::Lock::Timeout=180 remove -y --autoremove $PKGS ;;
    *) echo "E: install or remove"; exit 2 ;;
  esac
}

case "${1:-}" in
  kiosk) kiosk ;;
  before-screen) before_screen ;;
  session) session ;;
  doctor) doctor ;;
  status) systemctl --no-pager status $SERVICES || true ;;
  logs) # shellcheck disable=SC2046
    journalctl --no-pager -n 120 $(for s in $SERVICES; do printf ' -u %s' "$s"; done) ;;
  report) report ;;
  pair-controller) pair_controller ;;
  choose) curl -fsS -m 5 -X POST -H "X-Sofa-Box: 1" -H "Content-Type: application/json" -d '{"to":"sofa"}' $AGENT/box/api/sofa/chooser >/dev/null \
            && echo "Pick your Sofa on the TV." ;;
  tv-on)
    DEV="$(ls /dev/cec* 2>/dev/null | head -n 1)"
    [ -n "$DEV" ] || { echo "No HDMI-CEC here."; exit 1; }
    cec-ctl -d "$DEV" --to 0 --image-view-on >/dev/null
    sleep 2
    PHYS="$(cec-ctl -d "$DEV" | sed -n 's/.*Physical Address *: *\([0-9a-f.]*\).*/\1/p' | head -n 1)"
    cec-ctl -d "$DEV" --to 15 --active-source phys-addr="$PHYS" >/dev/null
    echo "Asked the TV to turn on and show the box." ;;
  apply-boot) shift; apply_boot "$@" ;;
  setup-boot) shift; setup_boot "$@" ;;
  shield) shift; shield "$@" ;;
  games) shift; games "$@" ;;
  desktop)
    systemctl disable --now sofa-box
    for dm in lightdm gdm3 sddm; do systemctl list-unit-files "$dm.service" >/dev/null 2>&1 && systemctl enable "$dm" 2>/dev/null && { systemctl start "$dm"; break; }; done
    echo "The desktop is back. Sofa on the TV again: sudo sofa-box appliance" ;;
  appliance)
    for dm in lightdm gdm3 sddm; do systemctl disable --now "$dm" 2>/dev/null || true; done
    systemctl enable --now sofa-box
    echo "Sofa is on the TV again, at every start." ;;
  tune)                      # (root) the processor: up at once when something's pressed, down slowly
    for p in /sys/devices/system/cpu/cpufreq/policy*; do
      [ -w "$p/scaling_governor" ] || continue
      if grep -qw ondemand "$p/scaling_available_governors"; then
        echo ondemand > "$p/scaling_governor"
      elif grep -qw schedutil "$p/scaling_available_governors"; then
        echo schedutil > "$p/scaling_governor"
      fi
    done
    OD=/sys/devices/system/cpu/cpufreq/ondemand
    [ -w "$OD/up_threshold" ] && echo 40 > "$OD/up_threshold"
    [ -w "$OD/sampling_down_factor" ] && echo 20 > "$OD/sampling_down_factor"
    wifi_on
    echo "Tuned: $(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null || echo "no cpufreq here")" ;;
  wifi-on) wifi_on "${2:-}" ;;                # (root) Wi-Fi switched on (also at every start, with tune)
  timezone)                  # (root) the box's time zone, from the setup screen or a phone
    echo "${2:-}" | grep -Eq '^[A-Za-z]+(/[A-Za-z0-9_+-]+){1,2}$' || { echo "Which time zone? (like Europe/London)"; exit 1; }
    timedatectl set-timezone "$2" ;;
  update)                    # (root) the newest box from GitHub; the installer restarts what changed
    on_its_own update
    curl -fsSL "https://raw.githubusercontent.com/krintoxi/sofa/${SOFA_BOX_BRANCH:-main}/deploy/sofa-box/install.sh" | sh ;;
  factory-reset)             # (root) everything of the owner's goes; the box starts at its setup screen
    on_its_own factory-reset
    WHO="$(systemctl show -p User --value sofa-box-agent 2>/dev/null)"
    [ -n "$WHO" ] || { echo "The box's user isn't known."; exit 1; }
    HOMEDIR="$(getent passwd "$WHO" | cut -d: -f6)"
    systemctl stop sofa-box sofa-box-agent 2>/dev/null || true
    rm -rf "$HOMEDIR/.config/sofa-box" "$HOMEDIR/.local/share/sofa-box" "$HOMEDIR/.cache/chromium"
    for d in Downloads Videos Music Pictures; do [ -d "$HOMEDIR/$d" ] && find "$HOMEDIR/$d" -mindepth 1 -delete; done
    nmcli -t -f NAME,TYPE connection show 2>/dev/null | while IFS=: read -r name type; do
      [ "$type" = 802-11-wireless ] && nmcli connection delete "$name" >/dev/null 2>&1 || true
    done
    bluetoothctl devices Paired 2>/dev/null | awk '{print $2}' | while read -r mac; do bluetoothctl remove "$mac" >/dev/null 2>&1 || true; done
    echo "Back to how it came. Starting again…"
    systemctl reboot ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
